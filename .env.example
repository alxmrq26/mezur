# ============================================================
# MEZUR — variables d'environnement
# Ce fichier est un MODÈLE : il ne contient aucun secret réel.
# Copiez-le en `.env` pour un test local (le `.env` est ignoré par git)
# et saisissez les mêmes clés dans Vercel :
#   Vercel > le projet > Settings > Environment Variables
# ============================================================

# Mot de passe d'accès au back office (/admin.html). REQUIS.
ADMIN_PASSWORD=remplacez-moi-par-un-mot-de-passe-long

# Alternative à ADMIN_PASSWORD : empreinte SHA-256 du mot de passe,
# pour ne pas stocker le mot de passe en clair. Prioritaire si définie.
# Génération : echo -n "mon-mot-de-passe" | shasum -a 256
# ADMIN_PASSWORD_HASH=

# Clé de signature des cookies de session (optionnelle).
# Si absente, elle est dérivée automatiquement du mot de passe.
# Génération : openssl rand -hex 32
# ADMIN_SESSION_SECRET=

# ------------------------------------------------------------
# Base de données des réservations (Supabase)
# ------------------------------------------------------------

# URL du projet Supabase. REQUIS pour que les réservations
# prises sur le site arrivent jusqu'au back office.
# Supabase > le projet > Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé « service_role ». REQUISE, et STRICTEMENT SECRÈTE :
# elle contourne toutes les règles de sécurité de la base.
# Elle ne doit exister que dans les variables d'environnement
# Vercel, jamais dans un fichier servi au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# La clé « anon public », elle, se colle dans js/supabase-config.js :
# elle est publique par nature et ne peut qu'enregistrer une demande.
